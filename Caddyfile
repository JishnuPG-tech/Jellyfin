# ==============================================================================
# Apex Multi-Project Gateway Configuration
# Reverse Proxy & Routing for Hugging Face Spaces (Port 7860)
# ==============================================================================

:7860 {
	# ── Security Headers ──────────────────────────────────────────────────────
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		X-XSS-Protection "1; mode=block"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# ── 1. Stirling-PDF ───────────────────────────────────────────────────────
	handle_path /stirling* {
		reverse_proxy http://127.0.0.1:8080 {
			transport http {
				response_header_timeout 300s
				dial_timeout 30s
			}
		}
	}

	# ── 2. Apex Portal Static Dashboard ───────────────────────────────────────
	handle /portal/* {
		root * /srv/portal
		file_server
	}

	handle / {
		root * /srv/portal
		file_server {
			index index.html
		}
	}

	handle /index.html {
		root * /srv/portal
		file_server
	}

	# ── 3. Fallback: Redirect unrecognized paths to Portal ─────────────────────
	handle {
		redir /
	}
}
