# ==============================================================================
# Apex Multi-Project Gateway Configuration (Port 7860)
# ==============================================================================

:7860 {
	# ── Security Headers ──────────────────────────────────────────────────────
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		X-XSS-Protection "1; mode=block"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# ── 1. Stirling-PDF Proxy ──────────────────────────────────────────────────
	handle /stirling* {
		reverse_proxy 127.0.0.1:8080 {
			transport http {
				response_header_timeout 300s
				dial_timeout 30s
			}
		}
	}

	# ── 2. Lucent — PDF Enhancer & Restorer (FastAPI + React 19 on /enhancer*) ───
	redir /enhancer /enhancer/
	handle_path /enhancer* {
		reverse_proxy 127.0.0.1:8082 {
			transport http {
				response_header_timeout 600s
				dial_timeout 30s
			}
		}
	}

	# ── 3. Apex Portal Hub (Static Web UI) ────────────────────────────────────
	handle {
		root * /srv/portal
		file_server {
			index index.html
		}
	}
}
