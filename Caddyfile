# ==============================================================================
# Apex Multi-Project Gateway Configuration (Port 7860)
# ==============================================================================

:7860 {
	# ── 1. Stirling-PDF Proxy ──────────────────────────────────────────────────
	handle /stirling* {
		reverse_proxy 127.0.0.1:8080
	}

	# ── 2. Apex Portal Hub (Static Web UI) ────────────────────────────────────
	handle {
		root * /srv/portal
		file_server {
			index index.html
		}
	}
}
