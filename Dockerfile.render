# Dockerfile optimized for Render.com
# Hermes Agent - Telegram Bot Gateway with Unrestricted Networking

FROM python:3.11-slim

WORKDIR /app

# Set environment variables
ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    HERMES_HOME=/app/data \
    PATH="/app/.venv/bin:${PATH}"

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    curl \
    wget \
    build-essential \
    libffi-dev \
    ripgrep \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/*

# Copy project files from the build context (your GitHub repo)
COPY . .

# Create data directory for persistent storage
RUN mkdir -p /app/data

# Install Python dependencies (including FastAPI for Vapi bridge)
RUN pip install --upgrade pip setuptools wheel && \
    pip install -e . && \
    pip install "fastapi>=0.110.0,<1" "uvicorn[standard]>=0.29.0,<1"

# Pre-install critical lazy dependencies at build time so first requests
# don't block for 3+ minutes on pip installs at runtime.
# These match exactly the versions pinned in tools/lazy_deps.py LAZY_DEPS.
RUN pip install \
    "openai>=1.0.0" \
    "edge-tts==7.2.7" \
    "anthropic==0.87.0" \
    "python-telegram-bot[webhooks]==22.6"

# Write the startup script
COPY <<'EOF' /app/start.sh
#!/bin/bash
set -e

echo "===== Application Startup at $(date) ====="
echo "🚀 Starting Hermes Agent on Render.com..."

mkdir -p $HERMES_HOME

# Write environment file
cat > $HERMES_HOME/.env << ENVEOF
OPENROUTER_API_KEY=${OPENROUTER_API_KEY}
TELEGRAM_BOT_TOKEN=${TELEGRAM_BOT_TOKEN}
FIRECRAWL_API_KEY=${FIRECRAWL_API_KEY}
GITHUB_TOKEN=${GITHUB_TOKEN}
COPILOT_GITHUB_TOKEN=${COPILOT_GITHUB_TOKEN}
TELEGRAM_HOME_CHANNEL=${TELEGRAM_HOME_CHANNEL}
GATEWAY_ALLOW_ALL_USERS=true
ENVEOF
echo "✓ Environment configured"

# ─────────────────────────────────────────────
# PERSISTENT SESSION STORAGE via Supabase
# Downloads state.db on startup, uploads on exit
# ─────────────────────────────────────────────
SUPABASE_URL="${SUPABASE_URL}"
SUPABASE_KEY="${SUPABASE_KEY}"
STATE_DB="$HERMES_HOME/state.db"
SUPABASE_BUCKET="hermes"
SUPABASE_PATH="state.db"

supabase_download() {
  if [ -n "$SUPABASE_URL" ] && [ -n "$SUPABASE_KEY" ]; then
    echo "☁️  Downloading session state from Supabase..."
    HTTP=$(curl -s -o "$STATE_DB.tmp" -w "%{http_code}" \
      --max-time 30 \
      "${SUPABASE_URL}/storage/v1/object/${SUPABASE_BUCKET}/${SUPABASE_PATH}" \
      -H "Authorization: Bearer ${SUPABASE_KEY}" \
      -H "apikey: ${SUPABASE_KEY}")
    if [ "$HTTP" = "200" ] && [ -s "$STATE_DB.tmp" ]; then
      mv "$STATE_DB.tmp" "$STATE_DB"
      echo "✓ Session state restored ($(du -sh $STATE_DB | cut -f1))"
    else
      rm -f "$STATE_DB.tmp"
      echo "ℹ️  No existing session state found — starting fresh."
    fi
  else
    echo "ℹ️  Supabase not configured — sessions won't persist across restarts."
  fi
}

supabase_upload() {
  if [ -n "$SUPABASE_URL" ] && [ -n "$SUPABASE_KEY" ] && [ -f "$STATE_DB" ]; then
    echo "☁️  Saving session state to Supabase..."
    HTTP=$(curl -s -o /dev/null -w "%{http_code}" \
      --max-time 30 \
      -X POST \
      "${SUPABASE_URL}/storage/v1/object/${SUPABASE_BUCKET}/${SUPABASE_PATH}" \
      -H "Authorization: Bearer ${SUPABASE_KEY}" \
      -H "apikey: ${SUPABASE_KEY}" \
      -H "Content-Type: application/octet-stream" \
      -H "x-upsert: true" \
      --data-binary "@${STATE_DB}")
    if [ "$HTTP" = "200" ] || [ "$HTTP" = "201" ]; then
      echo "✓ Session state saved to Supabase."
    else
      echo "⚠️  Failed to save session state (HTTP $HTTP)."
    fi
  fi
}

# Periodic background sync every 5 minutes
periodic_sync() {
  while true; do
    sleep 300
    supabase_upload
  done
}

# On SIGTERM (Render shutdown) — save state before exit
graceful_shutdown() {
  echo ""
  echo "🛑 Shutdown signal received — saving session state..."
  supabase_upload
  echo "✓ Goodbye!"
  exit 0
}
trap graceful_shutdown SIGTERM SIGINT

# Restore session state on startup
supabase_download

# Determine default model configuration based on available keys
if [ -n "$COPILOT_GITHUB_TOKEN" ] || [ -n "$GITHUB_TOKEN" ]; then
    echo "🤖 Selecting GitHub Copilot as default provider"
    DEFAULT_MODEL="claude-haiku-4.5"
    DEFAULT_PROVIDER="copilot"
    DEFAULT_BASE_URL="https://api.githubcopilot.com"
    DEFAULT_API_MODE="anthropic_messages"
elif [ -n "$OPENROUTER_API_KEY" ]; then
    echo "🤖 Selecting OpenRouter as default provider"
    DEFAULT_MODEL="anthropic/claude-3.5-haiku"
    DEFAULT_PROVIDER="openrouter"
    DEFAULT_BASE_URL="https://openrouter.ai/api/v1"
    DEFAULT_API_MODE="chat_completions"
else
    echo "🤖 No default credentials found; defaulting to GitHub Copilot"
    DEFAULT_MODEL="claude-haiku-4.5"
    DEFAULT_PROVIDER="copilot"
    DEFAULT_BASE_URL="https://api.githubcopilot.com"
    DEFAULT_API_MODE="anthropic_messages"
fi

cat > $HERMES_HOME/config.yaml << YAML
model:
  default: ${DEFAULT_MODEL}
  provider: ${DEFAULT_PROVIDER}
  base_url: ${DEFAULT_BASE_URL}
  api_mode: ${DEFAULT_API_MODE}
agent:
  max_turns: 90
  gateway_timeout: 1800
terminal:
  backend: local
  cwd: /tmp
web:
  extract_backend: firecrawl
telegram:
  reactions: false
  channel_prompts: {}
  allowed_chats: ''
gateway:
  enabled: true
  platforms:
    telegram:
      enabled: true
display:
  show_cost: false
  skin: default
logging:
  level: INFO
YAML
echo "✓ Config configured"

echo "✓ Configuration ready"
echo ""
echo "🔗 Hermes Agent is starting..."
echo "   📱 Telegram Bot: Polling mode"
echo "   🤖 Model: arcee-ai/trinity-large-thinking:free via OpenRouter"
echo "   🌐 Web Extraction: Firecrawl"
echo "   💾 Session Storage: Supabase (persistent)"
echo ""

# Start periodic sync in background
periodic_sync &
SYNC_PID=$!

# Start the Flutter Integration FastAPI server (also serves as health check endpoint).
PORT="${PORT:-10000}"
echo "✓ Starting Hermes App API on port $PORT..."
uvicorn hermes_app_api:app --host 0.0.0.0 --port "$PORT" --workers 1 --log-level warning &
API_PID=$!

# Give uvicorn a moment to bind before the gateway starts
sleep 3
echo "✓ Hermes App API ready — endpoint: https://myhermesagent.onrender.com/v1/chat/completions"

cd /app
hermes gateway run &
GATEWAY_PID=$!

# Keep container running as long as uvicorn (Hermes App API) is alive
wait $API_PID

# If uvicorn exits, do final save and exit
supabase_upload
EOF

RUN chmod +x /app/start.sh

# Expose port for Render health check
EXPOSE 10000

# Run the gateway
CMD ["/bin/bash", "/app/start.sh"]
