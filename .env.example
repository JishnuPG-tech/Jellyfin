# API Keys (at least one required for AI features)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# SSH password — used by Termius to log in through the reverse tunnel
# If unset, a random password is printed to Space logs on each startup
SSH_PASSWORD=

# Reverse SSH tunnel to Fly.io jump server
# JUMP_HOST       : your Fly.io app hostname, e.g. opencode-jump.fly.dev
# JUMP_SSH_KEY    : private ed25519 key (PEM format, single line with \n)
#                   generated with: ssh-keygen -t ed25519 -f jump_key -N ""
#                   paste the contents of jump_key (private) here
# The matching public key (jump_key.pub) goes into Fly.io secret JUMP_AUTHORIZED_KEY
JUMP_HOST=
JUMP_SSH_KEY=

# Optional: HTTP Basic Auth for the OpenCode server
OPENCODE_SERVER_USERNAME=
OPENCODE_SERVER_PASSWORD=
