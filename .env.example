# API Keys (at least one required for AI features)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# SSH access via Cloudflare Named Tunnel
# Required for Termius connections.
# Steps:
#   1. Log in to https://one.dash.cloudflare.com
#   2. Go to Zero Trust → Networks → Tunnels
#   3. Create a tunnel (or select an existing one)
#   4. Under "Public Hostname", add a hostname routed to:
#        Service type: SSH
#        URL:          localhost:22
#   5. On the tunnel's Overview tab, copy the tunnel token
#   6. Paste it here (or add as a Hugging Face Space Secret)
CF_TUNNEL_TOKEN=

# SSH password for the root user inside the container.
# If omitted, a random password is generated and printed to Space logs on startup.
SSH_PASSWORD=

# Optional: HTTP Basic Auth for the OpenCode server
OPENCODE_SERVER_USERNAME=
OPENCODE_SERVER_PASSWORD=
